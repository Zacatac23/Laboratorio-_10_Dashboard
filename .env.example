# Copiar a .env (no versionado) y ajustar. Valores de ejemplo, sin datos reales.
# Rutas del host montadas en los contenedores (relativas a docker-compose.yml o absolutas).
OBS_DATA_DIR=./data
OBS_LOGS_DIR=./logs
OBS_REPORTS_DIR=./reports
# Almacén MLflow: nombre de volumen Docker (recomendado para SQLite) o ruta del host.
OBS_MLFLOW_STORE=mlflow_store
# Puertos publicados solo en 127.0.0.1
MLFLOW_PORT=5000
DASHBOARD_PORT=8501
# Commit del código ejecutado (en el host: git rev-parse HEAD). Vacío = NO_DISPONIBLE.
GIT_COMMIT=
# Responsable de restauraciones ejecutadas en contenedor
RESTORE_OPERATOR=
# Zona horaria para fecha_generacion y auditoría
TZ=America/Guatemala
